## CoinList SDK (client + server)
## Copy to `.env` (or `.env.local`) and fill in real values.

# Safe to expose to the browser (Next.js requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_COINLIST_CLIENT_ID="your_client_id_here"
NEXT_PUBLIC_COINLIST_REDIRECT_URI="http://localhost:3000/oauth/coinlist/callback"

# Server-only secrets (DO NOT prefix with NEXT_PUBLIC_)
COINLIST_CLIENT_SECRET="your_client_secret_here"

# WalletConnect / Reown AppKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id_here"

