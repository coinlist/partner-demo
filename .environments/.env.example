## CoinList SDK (client + server)
## Copy to `.env` (or `.env.local`) and fill in real values.

# Safe to expose to the browser (Next.js requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_COINLIST_CLIENT_ID="your_client_id_here"
NEXT_PUBLIC_COINLIST_REDIRECT_URI="http://localhost:3000/oauth/coinlist/callback"

# CoinList hosts. Leave unset for production; set both together when pointing at
# a non-prod environment, and use credentials issued by that same environment.
# NEXT_PUBLIC_COINLIST_BASE_URL="https://api.example.coinlist.test"  # API: data calls + token exchange
# NEXT_PUBLIC_COINLIST_WEB_URL="https://example.coinlist.test"       # web: OAuth authorize + redirects

# Chain the demo runs on: ethereum_mainnet (default) or ethereum_sepolia.
# NEXT_PUBLIC_CHAIN="ethereum_sepolia"

# Server-only secrets (DO NOT prefix with NEXT_PUBLIC_)
COINLIST_CLIENT_SECRET="your_client_secret_here"

# WalletConnect / Reown AppKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id_here"

# Internal use only — DO NOT SET.
# These override the CoinList API and web hosts the SDK talks to. They exist so
# CoinList can point the demo at internal beta environments; partners should
# leave them unset so the SDK defaults to the stable production environment.
# NEXT_PUBLIC_COINLIST_BASE_URL="<internal beta API host>"
# NEXT_PUBLIC_COINLIST_WEB_URL="<internal beta web host>"

